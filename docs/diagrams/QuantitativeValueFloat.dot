// Diagram for QuantitativeValueFloat
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
		QuantitativeValue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">QuantitativeValue</TD></TR></TABLE>> URL="../QuantitativeValue" margin=0]
	}
	QuantitativeValueFloat [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">QuantitativeValueFloat</TD></TR><TR><TD ALIGN="LEFT">description : rdfs:Literal</TD></TR><TR><TD ALIGN="LEFT">hasMaxValueFloat : xsd:float</TD></TR><TR><TD ALIGN="LEFT">hasMinValueFloat : xsd:float</TD></TR><TR><TD ALIGN="LEFT">hasValueFloat : xsd:float</TD></TR><TR><TD ALIGN="LEFT">name : rdfs:Literal</TD></TR></TABLE>> URL="../QuantitativeValueFloat" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
	}
	QuantitativeValueFloat -> QuantitativeValue [arrowhead=onormal style=solid]
}
