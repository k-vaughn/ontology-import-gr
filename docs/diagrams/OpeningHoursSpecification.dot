// Diagram for OpeningHoursSpecification
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
	}
	OpeningHoursSpecification [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">OpeningHoursSpecification</TD></TR><TR><TD ALIGN="LEFT">closes : xsd:time</TD></TR><TR><TD ALIGN="LEFT">description : rdfs:Literal</TD></TR><TR><TD ALIGN="LEFT">name : rdfs:Literal</TD></TR><TR><TD ALIGN="LEFT">opens : xsd:time</TD></TR><TR><TD ALIGN="LEFT">validFrom : xsd:dateTime</TD></TR><TR><TD ALIGN="LEFT">validThrough : xsd:dateTime</TD></TR></TABLE>> URL="../OpeningHoursSpecification" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		DayOfWeek [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">DayOfWeek</TD></TR></TABLE>> URL="../DayOfWeek" margin=0]
	}
	OpeningHoursSpecification -> Invis [style=invis]
	Invis -> DayOfWeek [style=invis]
	DayOfWeek [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">DayOfWeek</TD></TR></TABLE>> URL="../DayOfWeek" margin=0]
	OpeningHoursSpecification -> DayOfWeek [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasOpeningHoursDayOfWeek</TD></TR></TABLE>> arrowhead=normal style=solid]
}
