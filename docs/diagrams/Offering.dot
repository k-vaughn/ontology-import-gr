// Diagram for Offering
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
	}
	Offering [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Offering</TD></TR><TR><TD ALIGN="LEFT">availabilityEnds : xsd:dateTime</TD></TR><TR><TD ALIGN="LEFT">availabilityStarts : xsd:dateTime</TD></TR><TR><TD ALIGN="LEFT">category : rdfs:Literal</TD></TR><TR><TD ALIGN="LEFT">condition : rdfs:Literal</TD></TR><TR><TD ALIGN="LEFT">description : rdfs:Literal</TD></TR><TR><TD ALIGN="LEFT">eligibleRegions : xsd:string</TD></TR><TR><TD ALIGN="LEFT">hasEAN_UCC-13 : xsd:string</TD></TR><TR><TD ALIGN="LEFT">hasGTIN-14 : xsd:string</TD></TR><TR><TD ALIGN="LEFT">hasGTIN-8 : xsd:string</TD></TR><TR><TD ALIGN="LEFT">hasMPN : xsd:string</TD></TR><TR><TD ALIGN="LEFT">hasStockKeepingUnit : xsd:string</TD></TR><TR><TD ALIGN="LEFT">name : rdfs:Literal</TD></TR><TR><TD ALIGN="LEFT">serialNumber : xsd:string</TD></TR><TR><TD ALIGN="LEFT">validFrom : xsd:dateTime</TD></TR><TR><TD ALIGN="LEFT">validThrough : xsd:dateTime</TD></TR></TABLE>> URL="../Offering" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		BusinessEntityType [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">BusinessEntityType</TD></TR></TABLE>> URL="../BusinessEntityType" margin=0]
		BusinessFunction [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">BusinessFunction</TD></TR></TABLE>> URL="../BusinessFunction" margin=0]
		DeliveryMethod [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">DeliveryMethod</TD></TR></TABLE>> URL="../DeliveryMethod" margin=0]
		Location [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Location</TD></TR></TABLE>> URL="../Location" margin=0]
		PaymentMethod [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PaymentMethod</TD></TR></TABLE>> URL="../PaymentMethod" margin=0]
		PriceSpecification [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PriceSpecification</TD></TR></TABLE>> URL="../PriceSpecification" margin=0]
		ProductOrService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">ProductOrService</TD></TR></TABLE>> URL="../ProductOrService" margin=0]
		QuantitativeValue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">QuantitativeValue</TD></TR></TABLE>> URL="../QuantitativeValue" margin=0]
		QuantitativeValueFloat [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">QuantitativeValueFloat</TD></TR></TABLE>> URL="../QuantitativeValueFloat" margin=0]
		QuantitativeValueInteger [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">QuantitativeValueInteger</TD></TR></TABLE>> URL="../QuantitativeValueInteger" margin=0]
		TypeAndQuantityNode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">TypeAndQuantityNode</TD></TR></TABLE>> URL="../TypeAndQuantityNode" margin=0]
		WarrantyPromise [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">WarrantyPromise</TD></TR></TABLE>> URL="../WarrantyPromise" margin=0]
	}
	Offering -> Invis [style=invis]
	Invis -> BusinessEntityType [style=invis]
	BusinessEntityType -> BusinessFunction [style=invis]
	BusinessFunction -> DeliveryMethod [style=invis]
	DeliveryMethod -> Location [style=invis]
	Location -> PaymentMethod [style=invis]
	PaymentMethod -> PriceSpecification [style=invis]
	PriceSpecification -> ProductOrService [style=invis]
	ProductOrService -> QuantitativeValue [style=invis]
	QuantitativeValue -> QuantitativeValueFloat [style=invis]
	QuantitativeValueFloat -> QuantitativeValueInteger [style=invis]
	QuantitativeValueInteger -> TypeAndQuantityNode [style=invis]
	TypeAndQuantityNode -> WarrantyPromise [style=invis]
	PaymentMethod [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PaymentMethod</TD></TR></TABLE>> URL="../PaymentMethod" margin=0]
	Offering -> PaymentMethod [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">acceptedPaymentMethods</TD></TR></TABLE>> arrowhead=normal style=solid]
	Offering [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Offering</TD></TR></TABLE>> URL="../Offering" margin=0]
	Offering -> Offering [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">addOn</TD></TR></TABLE>> arrowhead=normal style=solid]
	QuantitativeValueInteger [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">QuantitativeValueInteger</TD></TR></TABLE>> URL="../QuantitativeValueInteger" margin=0]
	Offering -> QuantitativeValueInteger [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">advanceBookingRequirement</TD></TR></TABLE>> arrowhead=normal style=solid]
	Location [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Location</TD></TR></TABLE>> URL="../Location" margin=0]
	Offering -> Location [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">availableAtOrFrom</TD></TR></TABLE>> arrowhead=normal style=solid]
	DeliveryMethod [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">DeliveryMethod</TD></TR></TABLE>> URL="../DeliveryMethod" margin=0]
	Offering -> DeliveryMethod [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">availableDeliveryMethods</TD></TR></TABLE>> arrowhead=normal style=solid]
	Offering -> QuantitativeValueInteger [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">deliveryLeadTime</TD></TR></TABLE>> arrowhead=normal style=solid]
	BusinessEntityType [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">BusinessEntityType</TD></TR></TABLE>> URL="../BusinessEntityType" margin=0]
	Offering -> BusinessEntityType [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">eligibleCustomerTypes</TD></TR></TABLE>> arrowhead=normal style=solid]
	QuantitativeValue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">QuantitativeValue</TD></TR></TABLE>> URL="../QuantitativeValue" margin=0]
	Offering -> QuantitativeValue [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">eligibleDuration</TD></TR></TABLE>> arrowhead=normal style=solid]
	PriceSpecification [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">PriceSpecification</TD></TR></TABLE>> URL="../PriceSpecification" margin=0]
	Offering -> PriceSpecification [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">eligibleTransactionVolume</TD></TR></TABLE>> arrowhead=normal style=solid]
	BusinessFunction [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">BusinessFunction</TD></TR></TABLE>> URL="../BusinessFunction" margin=0]
	Offering -> BusinessFunction [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasBusinessFunction</TD></TR></TABLE>> arrowhead=normal style=solid]
	Offering -> QuantitativeValue [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasEligibleQuantity</TD></TR></TABLE>> arrowhead=normal style=solid]
	QuantitativeValueFloat [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">QuantitativeValueFloat</TD></TR></TABLE>> URL="../QuantitativeValueFloat" margin=0]
	Offering -> QuantitativeValueFloat [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasInventoryLevel</TD></TR></TABLE>> arrowhead=normal style=solid]
	Offering -> PriceSpecification [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasPriceSpecification</TD></TR></TABLE>> arrowhead=normal style=solid]
	WarrantyPromise [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">WarrantyPromise</TD></TR></TABLE>> URL="../WarrantyPromise" margin=0]
	Offering -> WarrantyPromise [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasWarrantyPromise</TD></TR></TABLE>> arrowhead=normal style=solid]
	ProductOrService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">ProductOrService</TD></TR></TABLE>> URL="../ProductOrService" margin=0]
	Offering -> ProductOrService [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">includes</TD></TR></TABLE>> arrowhead=normal style=solid]
	TypeAndQuantityNode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">TypeAndQuantityNode</TD></TR></TABLE>> URL="../TypeAndQuantityNode" margin=0]
	Offering -> TypeAndQuantityNode [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">includesObject</TD></TR></TABLE>> arrowhead=normal style=solid]
}
