// Diagram for BusinessEntity
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
	}
	BusinessEntity [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">BusinessEntity</TD></TR><TR><TD ALIGN="LEFT">category : rdfs:Literal</TD></TR><TR><TD ALIGN="LEFT">description : rdfs:Literal</TD></TR><TR><TD ALIGN="LEFT">hasDUNS : xsd:string</TD></TR><TR><TD ALIGN="LEFT">hasGlobalLocationNumber : xsd:string</TD></TR><TR><TD ALIGN="LEFT">hasISICv4 : xsd:int</TD></TR><TR><TD ALIGN="LEFT">hasNAICS : xsd:int</TD></TR><TR><TD ALIGN="LEFT">legalName : rdfs:Literal</TD></TR><TR><TD ALIGN="LEFT">name : rdfs:Literal</TD></TR><TR><TD ALIGN="LEFT">taxID : xsd:string</TD></TR><TR><TD ALIGN="LEFT">vatID : xsd:string</TD></TR></TABLE>> URL="../BusinessEntity" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		Brand [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Brand</TD></TR></TABLE>> URL="../Brand" margin=0]
		Individual [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Individual</TD></TR></TABLE>> URL="../Individual" margin=0]
		Location [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Location</TD></TR></TABLE>> URL="../Location" margin=0]
		Offering [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Offering</TD></TR></TABLE>> URL="../Offering" margin=0]
	}
	BusinessEntity -> Invis [style=invis]
	Invis -> Brand [style=invis]
	Brand -> Individual [style=invis]
	Individual -> Location [style=invis]
	Location -> Offering [style=invis]
	Brand [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Brand</TD></TR></TABLE>> URL="../Brand" margin=0]
	BusinessEntity -> Brand [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasBrand</TD></TR></TABLE>> arrowhead=normal style=solid]
	Location [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Location</TD></TR></TABLE>> URL="../Location" margin=0]
	BusinessEntity -> Location [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">hasPOS</TD></TR></TABLE>> arrowhead=normal style=solid]
	Offering [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Offering</TD></TR></TABLE>> URL="../Offering" margin=0]
	BusinessEntity -> Offering [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">offers</TD></TR></TABLE>> arrowhead=normal style=solid]
	Individual [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">Individual</TD></TR></TABLE>> URL="../Individual" margin=0]
	BusinessEntity -> Individual [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">owns</TD></TR></TABLE>> arrowhead=normal style=solid]
	BusinessEntity -> Offering [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">seeks</TD></TR></TABLE>> arrowhead=normal style=solid]
}
