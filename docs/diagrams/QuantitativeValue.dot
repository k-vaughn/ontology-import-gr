// Diagram for QuantitativeValue
digraph {
	graph [overlap=false rankdir=TB splines=true]
	node [fontname=Arial fontsize=12 margin=0 shape=none]
	edge [fontname=Arial fontsize=11]
	{
		rank=source
	}
	QuantitativeValue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">QuantitativeValue</TD></TR><TR><TD ALIGN="LEFT">description : rdfs:Literal</TD></TR><TR><TD ALIGN="LEFT">hasMaxValue : rdfs:Literal</TD></TR><TR><TD ALIGN="LEFT">hasMinValue : rdfs:Literal</TD></TR><TR><TD ALIGN="LEFT">hasUnitOfMeasurement : xsd:string</TD></TR><TR><TD ALIGN="LEFT">hasValue : rdfs:Literal</TD></TR><TR><TD ALIGN="LEFT">name : rdfs:Literal</TD></TR></TABLE>> URL="../QuantitativeValue" margin=0]
	{
		rank=max
	}
	subgraph cluster_associated {
		label="" style=invis
		Invis [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD></TD></TR></TABLE>> margin=0 style=invis]
		QualitativeValue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">QualitativeValue</TD></TR></TABLE>> URL="../QualitativeValue" margin=0]
	}
	QuantitativeValue -> Invis [style=invis]
	Invis -> QualitativeValue [style=invis]
	QualitativeValue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD BGCOLOR="lightgray" ALIGN="CENTER">QualitativeValue</TD></TR></TABLE>> URL="../QualitativeValue" margin=0]
	QuantitativeValue -> QualitativeValue [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">valueReference</TD></TR></TABLE>> arrowhead=normal style=solid]
}
