# SHACL shapes derived from rdfs:domain / rdfs:range in gr.ttl.
# Informative companion for ont2md documentation — not a semantic change to GoodRelations.
# Schema.org alignment classes that appear in domain unions are omitted as shape targets;
# only GoodRelations classes receive NodeShapes.

BASE <http://purl.org/goodrelations/v1/>

PREFIX : <http://purl.org/goodrelations/v1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX vann: <http://purl.org/vocab/vann/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:gr-shacl
	a owl:Ontology ;
	dcterms:title "GoodRelations Ontology - SHACL constraints" ;
	skos:definition "SHACL node shapes that restate property domains and ranges from the GoodRelations ontology for documentation and validation tooling." ;
	vann:preferredNamespaceUri "http://purl.org/goodrelations/v1/"^^xsd:anyURI ;
	vann:preferredNamespacePrefix "gr"^^xsd:string ;
	owl:imports <http://purl.org/goodrelations/v1/> ;
	.

# #################################################################
# #
# #    Brand
# #
# #################################################################

:BrandShape
	a sh:NodeShape ;
	sh:targetClass :Brand ;
	sh:property [
		sh:path :description ;
		sh:datatype rdfs:Literal ;
	] ;
	sh:property [
		sh:path :name ;
		sh:datatype rdfs:Literal ;
	] .

# #################################################################
# #
# #    BusinessEntity
# #
# #################################################################

:BusinessEntityShape
	a sh:NodeShape ;
	sh:targetClass :BusinessEntity ;
	sh:property [
		sh:path :category ;
		sh:datatype rdfs:Literal ;
	] ;
	sh:property [
		sh:path :description ;
		sh:datatype rdfs:Literal ;
	] ;
	sh:property [
		sh:path :hasBrand ;
		sh:class :Brand ;
	] ;
	sh:property [
		sh:path :hasDUNS ;
		sh:datatype xsd:string ;
	] ;
	sh:property [
		sh:path :hasGlobalLocationNumber ;
		sh:datatype xsd:string ;
	] ;
	sh:property [
		sh:path :hasISICv4 ;
		sh:datatype xsd:int ;
	] ;
	sh:property [
		sh:path :hasNAICS ;
		sh:datatype xsd:int ;
	] ;
	sh:property [
		sh:path :hasPOS ;
		sh:class :Location ;
	] ;
	sh:property [
		sh:path :legalName ;
		sh:datatype rdfs:Literal ;
	] ;
	sh:property [
		sh:path :name ;
		sh:datatype rdfs:Literal ;
	] ;
	sh:property [
		sh:path :offers ;
		sh:class :Offering ;
	] ;
	sh:property [
		sh:path :owns ;
		sh:class :Individual ;
	] ;
	sh:property [
		sh:path :seeks ;
		sh:class :Offering ;
	] ;
	sh:property [
		sh:path :taxID ;
		sh:datatype xsd:string ;
	] ;
	sh:property [
		sh:path :vatID ;
		sh:datatype xsd:string ;
	] .

