		sh:class :ProductOrService ;
	] ;
	sh:property [
		sh:path :isSimilarTo ;
		sh:class :ProductOrService ;
	] ;
	sh:property [
		sh:path :name ;
		sh:datatype rdfs:Literal ;
	] ;
	sh:property [
		sh:path :qualitativeProductOrServiceProperty ;
		sh:class :QualitativeValue ;
	] ;
	sh:property [
		sh:path :quantitativeProductOrServiceProperty ;
